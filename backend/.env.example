# DeepGuard Backend Environment Variables
# Copy this file to .env and fill in your values

PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/deepguard
# OR use MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/deepguard

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# JWT
JWT_SECRET=deepguard_super_secret_jwt_key_change_this_in_production_2024
JWT_EXPIRES_IN=7d

# FastAPI AI Engine
FASTAPI_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads

# Ollama (Local LLM for report generation - FREE)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Install Ollama: https://ollama.ai
# Pull model: ollama pull llama3.2
# If Ollama not available, reports generate without AI text

# Email (optional - for alert notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
